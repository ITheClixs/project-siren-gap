# raw literature scan dumps (script re-generates)
.lit_cache/

# raw INR shards (safetensors) — released via HF Hub, never committed.
# Anchored with a leading slash: an unanchored `data/` also swallowed the source
# package `src/sirengap/data/` (loaders + schema), which silently went uncommitted.
/data/
*.safetensors

# python
__pycache__/
*.pyc
.venv/
*.egg-info/

# os / editors
.DS_Store
.idea/
.vscode/

# large run outputs (per-seed CSVs + figures under results/ ARE committed;
# anything under results/raw/ is not)
results/raw/

# compiled chapter PDFs (tectonic output)
*.pdf
paper/*.log
dist/

# Manuscript sources are kept out of the public tree. Result figures under
# paper/figures/ stay tracked because the README displays them.
paper/*.tex
paper/*.log
paper/tables/
paper/icml/
paper/icml-anon/
paper/iclr-anon/
paper/thesis/
paper/paperA/
paper/paperB/
paper/paperC/
# Packages the manuscript, which is not tracked here.
scripts/55_build_arxiv_package.sh
